{
  "manifest_version": 3,
  "name": "MindSweep",
  "version": "1.0.0",
  "permissions": [
    "notifications",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "description": "A relaxed timer to sweep away distractions.",
  "icons": {
    "128": "assets/MindSweep_v2.png"
  },
  "action": {
    "default_popup": "popup.html"
  }
}